# systemd unit for Linux hosts (Raspberry Pi 5 and friends). Installed by deploy/install.sh.
[Unit]
Description=Fleetwatch for Epiphan Edge: read-only watcher for an Epiphan Edge fleet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/fleetwatch
EnvironmentFile=-%h/fleetwatch/.env
ExecStart=%h/.local/bin/uv run --frozen fleetwatch run
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=%h/.fleetwatch %h/fleetwatch/.venv -%h/.cache/uv
PrivateTmp=true

[Install]
WantedBy=default.target
