<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent for macOS (Apple Silicon Mac mini and others). Installed by deploy/install.sh. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.fleetwatch.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV__</string><string>run</string><string>--frozen</string><string>fleetwatch</string><string>run</string>
  </array>
  <key>WorkingDirectory</key><string>__DIR__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__HOME__/.fleetwatch/agent.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.fleetwatch/agent.log</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/usr/bin:/bin:/usr/local/bin:__HOME__/.local/bin</string></dict>
</dict>
</plist>
