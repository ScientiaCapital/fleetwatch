# systemd unit for Linux hosts (Raspberry Pi 5 and friends). Installed by deploy/install.sh.
[Unit]
Description=ProAV Agent Sentinel: read-only watcher for an Epiphan Edge fleet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/proav-agent
EnvironmentFile=-%h/proav-agent/.env
ExecStart=%h/.local/bin/uv run --frozen proav-agent run
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=%h/.proav-agent %h/proav-agent/.venv
PrivateTmp=true

[Install]
WantedBy=default.target
