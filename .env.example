# Epiphan Edge MCP endpoint for your region: go. (North America), eu., au. Must start with https://.
FLEETWATCH_EPIPHAN_MCP_URL=https://go.epiphan.cloud/mcp

# Slack bot token (chat:write scope) and the channel to post in. Leave empty to print to the console.
FLEETWATCH_SLACK_BOT_TOKEN=
FLEETWATCH_SLACK_CHANNEL=#av-ops

# Microsoft Teams: a Power Automate Workflows webhook URL (docs/install.md#microsoft-teams). A secret: the URL alone
# lets anyone post to the channel. Leave empty to skip Teams.
FLEETWATCH_TEAMS_WEBHOOK_URL=

# Where the Epiphan sign-in token is kept: auto, file, keychain or systemd-creds.
# auto = macOS Keychain on a Mac, systemd-creds on Linux with systemd 256+, otherwise a mode-600 file.
# FLEETWATCH_TOKEN_STORE=auto

# Optional: answer /fleetwatch check <room> in Slack over Socket Mode (no inbound port). App-level token, xapp-,
# with connections:write. Who may ask is set in policy.yaml (slack.allowed_user_ids). See docs/slack-commands.md.
FLEETWATCH_SLACK_APP_TOKEN=

# For v0.2, the assistant that proposes changes a person approves (docs/design/approved-writes.md). In progress:
# with a key, `fleetwatch ask` calls Anthropic; nothing in this version approves or runs a change.
#
# Anthropic API key for the assistant (it starts sk-ant-). A secret. When set, `fleetwatch ask` sends your question and
# redacted fleet data to the Anthropic API. Leave it empty to keep everything on this machine; `ask` then answers
# with keywords.
FLEETWATCH_ANTHROPIC_API_KEY=
# Which Claude model the assistant uses.
# FLEETWATCH_AI_MODEL=claude-haiku-5-5
# The write fence (v0.2). A change runs only when at least one of these two is set; with neither, every change is
# refused and `fleetwatch approve --serve` won't start. List the sandbox devices' IDs, comma-separated: a change to
# any other device is refused, whatever team the sandbox sign-in reaches. This doesn't depend on Epiphan reporting
# a team ID. List only devices that exist on the sandbox team: the check proves a device is on the signed-in team's
# list, not that the team is the sandbox, so a device that also exists on a real team would pass. Master device IDs
# only (8 to 32 characters, 0-9 and a-f), no channel IDs; `fleetwatch doctor` flags anything else.
# FLEETWATCH_WRITE_DEVICE_IDS=
# The sandbox team's ID, if Epiphan shows one. When set, v0.2 also refuses a change if the sandbox sign-in reaches a
# different team, and if Epiphan doesn't report a team ID at all. Leave it empty until the first live run confirms
# Epiphan exposes one.
# FLEETWATCH_WRITE_TEAM_ID=
# Where the sandbox sign-in is kept (`fleetwatch login --sandbox`): the only sign-in v0.2 may use to make a change.
# It must be a different file from FLEETWATCH_TOKEN_FILE; the Keychain and systemd-creds keep it under their own
# name too. With no sandbox sign-in, no change can run.
# FLEETWATCH_SANDBOX_TOKEN_FILE=~/.fleetwatch/epiphan-sandbox-oauth.json

# Rarely needed. Defaults shown.
# FLEETWATCH_EPIPHAN_TOKEN=                 # static bearer token for hosts that can't run the browser sign-in
# FLEETWATCH_OAUTH_CALLBACK_PORT=8765       # sign-in callback, 127.0.0.1 only
# FLEETWATCH_ASK_PORT=8766                  # fleetwatch ask --serve page, 127.0.0.1 only
# FLEETWATCH_APPROVE_PORT=8767              # fleetwatch approve --serve page (v0.2), 127.0.0.1 only
# FLEETWATCH_STATE_DB=~/.fleetwatch/state.db
# FLEETWATCH_TOKEN_FILE=~/.fleetwatch/epiphan-oauth.json
