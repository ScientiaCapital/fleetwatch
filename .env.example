# Epiphan Edge MCP endpoint for your region: go. (North America), eu., au. Must start with https://.
FLEETWATCH_EPIPHAN_MCP_URL=https://go.epiphan.cloud/mcp

# Slack bot token (chat:write scope) and the channel to post in. Leave empty to print to the console.
FLEETWATCH_SLACK_BOT_TOKEN=
FLEETWATCH_SLACK_CHANNEL=#av-ops

# Microsoft Teams: a Power Automate Workflows webhook URL (docs/install.md#microsoft-teams). A secret: the URL alone
# lets anyone post to the channel. Leave empty to skip Teams.
FLEETWATCH_TEAMS_WEBHOOK_URL=

# Where the Epiphan sign-in token is kept: auto, file, keychain or systemd-creds.
# auto = macOS Keychain on a Mac, systemd-creds on Linux with systemd 256+, otherwise a mode-600 file.
# FLEETWATCH_TOKEN_STORE=auto

# Optional: answer /fleetwatch check <room> in Slack over Socket Mode (no inbound port). App-level token, xapp-,
# with connections:write. Who may ask is set in policy.yaml (slack.allowed_user_ids). See docs/slack-commands.md.
FLEETWATCH_SLACK_APP_TOKEN=

# Rarely needed. Defaults shown.
# FLEETWATCH_EPIPHAN_TOKEN=                 # static bearer token for hosts that can't run the browser sign-in
# FLEETWATCH_OAUTH_CALLBACK_PORT=8765       # sign-in callback, 127.0.0.1 only
# FLEETWATCH_ASK_PORT=8766                  # fleetwatch ask --serve page, 127.0.0.1 only
# FLEETWATCH_STATE_DB=~/.fleetwatch/state.db
# FLEETWATCH_TOKEN_FILE=~/.fleetwatch/epiphan-oauth.json
