# Epiphan Edge MCP endpoint for your region: go. (North America), eu., au.
PROAV_EPIPHAN_MCP_URL=https://go.epiphan.cloud/mcp

# Slack bot token (chat:write scope) and the channel to post in. Leave empty to print to the console.
PROAV_SLACK_BOT_TOKEN=
PROAV_SLACK_CHANNEL=#av-ops

# Optional: rewrite messages in plain language with Claude. Templates are used when unset or on any error.
ANTHROPIC_API_KEY=
PROAV_LLM_POLISH=false
